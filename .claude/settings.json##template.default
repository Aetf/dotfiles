{
{% if yadm.hostname == "Aetf-Arch-Homelab" %}
  "permissions": {
    "allow": [
      "Bash(gh pr * --repo Aetf/kluster *)",
      "Bash(gh pr * --repo Aetf/teahouse *)",
      "Bash(gh issue * --repo Aetf/kluster *)",
      "Bash(gh issue * --repo Aetf/teahouse *)"
    ]
  },
  "enabledPlugins": {
    "unifi-network@unifi-plugins": true
  },
  "extraKnownMarketplaces": {
    "unifi-plugins": {
      "source": {
        "source": "github",
        "repo": "sirkirby/unifi-mcp"
      }
    }
  },
  "effortLevel": "medium",
{% endif %}
  "model": "fable[1m]",
  "theme": "auto",
  "remoteControlAtStartup": true,
  "autoContinueAtUsageLimit": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
