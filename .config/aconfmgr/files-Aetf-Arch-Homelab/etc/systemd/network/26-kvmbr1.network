[Match]
Name=kvmbr1

[Network]
# Host leg on the cluster VLAN (no DHCP server exists there). No Gateway=:
# the untagged LAN on enp7s0 owns the default route.
Address=192.168.70.2/24

IPForward=no
MulticastDNS=no
IPv6AcceptRA=yes

# RA is accepted for the SLAAC address only; the demoted metric keeps any
# default route it carries below the untagged link's (metric 10).
[IPv6AcceptRA]
RouteMetric=1024
