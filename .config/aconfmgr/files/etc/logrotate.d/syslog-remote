/var/log/remote/*.log {
    # Rotate the file once a day
    daily
    # Keep 7 days worth of old logs before deleting them
    rotate 7
    # Compress old logs using gzip
    compress
    # Delay compression of the most recent rotated file by one cycle
    delaycompress
    # Don't throw an error if the log file doesn't exist
    missingok
    # Don't rotate the file if it is empty
    notifempty
    # Recreate the new empty file with these permissions
    create 0640 root log
    # Only run postrotate single time for all matching files
    sharedscripts
    postrotate
        /bin/kill -HUP $(cat /run/syslog-ng-remote-only.pid 2>/dev/null) 2>/dev/null || true
    endscript
}
