[Unit]
Description=email-oauth2-proxy: XOAUTH2 bridge for HA's imap integration
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/emailproxy:latest
# Plain IMAP on the LAN for HA; the proxy handles TLS+OAuth towards Gmail.
PublishPort=1993:1993
# First-time account authorisation only: uncomment the next two lines, then
# trigger a client connection and follow the URL from `podman logs`.
# PublishPort=8080:8080
# Exec=--local-server-auth
# Static config (servers + OAuth client secret; yadm git-crypt).
Volume=%h/.config/emailproxy/emailproxy.config:/config/emailproxy.config:ro
# Mutable token cache, encrypted with the client-presented IMAP password.
Volume=%h/.local/state/emailproxy:/data

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
