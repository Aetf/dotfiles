{
	email "aetf@unlimited-code.works"
	debug
	admin unix//data/caddy/data/caddy/caddy-admin.sock

	# AdGuard answers upos-hz-mirrorakam.akamaized.net with this proxy so the
	# plain-HTTP site block below can re-home app video traffic (see there).
	# Browsers fetch the same name over HTTPS; there is no certificate for a
	# third-party name here, so pass those connections through to the real
	# Akamai edge untouched, before Caddy's own TLS gets to see them.
	servers :443 {
		listener_wrappers {
			layer4 {
				@akam tls sni upos-hz-mirrorakam.akamaized.net upos-sz-mirrorakam.akamaized.net
				route @akam {
					proxy {l4.tls.server_name}:443
				}
			}
			tls
		}
	}
}

*.lan.ucw.phd {
	tls {
		dns cloudflare {file./data/caddy/secrets/cf_token}
		resolvers 1.1.1.1
	}

	@tube host tube.lan.ucw.phd
	handle @tube {
		reverse_proxy aetf-arch-homelab.home.arpa:8096
	}

	@bt host bt.lan.ucw.phd
	handle @bt {
		reverse_proxy aetf-arch-homelab.home.arpa:9876
	}

	# adguard-alice is the primary (adguardhome-sync origin); dns.lan.ucw.phd
	# stays pointed at it. Per-instance names for reaching a specific UI.
	@dns host dns.lan.ucw.phd
	handle @dns {
		reverse_proxy 10.0.5.3
	}

	@dns_alice host dns-alice.lan.ucw.phd
	handle @dns_alice {
		reverse_proxy 10.0.5.3
	}

	@dns_bob host dns-bob.lan.ucw.phd
	handle @dns_bob {
		reverse_proxy 10.0.5.4
	}

	@gw host gw.lan.ucw.phd
	handle @gw {
		# UniFi OS rejects a WebSocket upgrade whose Origin does not match the
		# request Host (HTTP 500 on /api/ws/*), which blanks the console UI.
		# Caddy rewrites Host to the upstream for scheme-qualified upstreams,
		# so pass the client's Host through explicitly like every other site
		# here does by default.
		reverse_proxy https://dmse.home.arpa {
			header_up Host {host}
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}

	@spool host spool.lan.ucw.phd
	handle @spool {
		reverse_proxy aetf-arch-homelab.home.arpa:8000
	}

	@thread host thread.lan.ucw.phd
	handle @thread {
		reverse_proxy aetf-arch-homelab.home.arpa:8480
	}

	@seedwatch host seedwatch.lan.ucw.phd
	handle @seedwatch {
		reverse_proxy aetf-arch-homelab.home.arpa:8490
	}

	# go/<name> shortlinks (kluster golinks deployment, homelan LoadBalancer)
	@go host go.lan.ucw.phd
	handle @go {
		reverse_proxy aetf-arch-homelab.home.arpa:8067
	}

	# APC UPS network management card (AP9631). The card only accepts SSL
	# certificates in the Security Wizard's proprietary format and its TLS stack
	# is stuck on TLSv1.2/ECDHE-RSA-AES128-SHA, so terminate a real certificate
	# here and skip verification on the self-signed hop to the card.
	@ups host ups.lan.ucw.phd
	handle @ups {
		reverse_proxy https://ups.home.arpa {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# Fallback for otherwise unhandled domains
	handle {
		abort
	}
}

http://tube {
	redir https://tube.lan.ucw.phd{uri} permanent
}

http://bt {
	redir https://bt.lan.ucw.phd{uri} permanent
}

http://dns {
	redir https://dns.lan.ucw.phd{uri} permanent
}

http://gw {
	redir https://gw.lan.ucw.phd{uri} permanent
}

http://go {
	redir https://go.lan.ucw.phd{uri} permanent
}

# Bilibili CDN steering for the TV / mobile apps. Overseas, Bilibili hands
# each media stream to either Akamai or one of its cloud mirrors at random,
# and the apps fetch Akamai's share over plain HTTP; from here Akamai is the
# slowest edge by far (single connection ~8 Mbps vs 40+ on the mirrors, i.e.
# below 1080p60). AdGuard points the Akamai name at this proxy and the request
# is forwarded as-is to a mirror: the URL signature (upsig) covers only the
# query parameters listed in uparams, never the host, and the mirrors ignore
# Akamai's hdnts token. Client headers must pass through unchanged — app-signed
# URLs are refused with a browser Referer, so nothing is added here. Which
# mirror is fastest is measured by homelab-ops bili-cdn-probe; the HTTPS half
# of the traffic is steered by that script's AdGuard rules instead.
http://upos-hz-mirrorakam.akamaized.net {
	reverse_proxy upos-sz-mirrorcosov.bilivideo.com upos-sz-mirroraliov.bilivideo.com {
		lb_policy first
		fail_duration 30s
		header_up Host {http.reverse_proxy.upstream.host}
		flush_interval -1
	}
}
