#!/command/with-contenv ash

# 1. Define the socket path Caddy will write to via sd_notify
SOCK_NAME="/var/run/caddy-notify"
export NOTIFY_SOCKET="$SOCK_NAME"
PIPE="/var/run/caddy-socat.pipe"

# 2. Start a background listener to bridge the signal
#    - socat listens on the Abstract Unix Datagram socket (ABSTRACT-RECVGRAM)
#    - It pipes the output to grep
#    - grep waits specifically for "READY=1"
#    - Once found, we write a newline to FD 3 (inherited from s6) to signal readiness
(
    cleanup() {
        # If SOCAT_PID is set, kill it.
        if [ -n "$SOCAT_PID" ]; then
            kill "$SOCAT_PID"
        fi
        rm -f "$PIPE"
    }
    trap cleanup EXIT INT TERM

    mkfifo "$PIPE"
    socat -u UNIX-RECV:"$SOCK_NAME" PIPE:"$PIPE",unlink-close &
    SOCAT_PID=$!

    echo "Started socat with pid $SOCAT_PID"

    while read -r line; do
        if echo "$line" | grep -q "READY=1"; then
            echo "" >&3
            break
        fi
    done < "$PIPE"
) &

exec /usr/bin/caddy run --config $XDG_CONFIG_HOME/caddy/Caddyfile --adapter caddyfile
