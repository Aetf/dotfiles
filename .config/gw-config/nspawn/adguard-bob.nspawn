[Exec]
Boot=on
# s6-overlay (alpine image) does not do a clean SIGTERM shutdown; without
# these, stop leaves stale s6-supervise procs that wedge the unit cgroup
# (219/CGROUP on next start — bitten 2026-08-17). Same combo as caddy.nspawn.
KillSignal=SIGKILL
Environment=S6_KILL_GRACETIME=0
# Instance identity, read by the image's net-setup oneshot (with-contenv):
# static IPv4 + default route, and the SLAAC token set before host0 comes up
# so the v6 address is always <prefix>::a00:504. Static (not DHCP): the
# UniFi controller can't manage reservations for clients on the gateway's
# own bridge, and the veth MAC changes with every machine rename.
Environment=IPV4_CIDR=10.0.5.4/24
Environment=IPV4_GATEWAY=10.0.5.1
Environment=IPV6_TOKEN=::10.0.5.4
Capability=all
ResolvConf=off

[Network]
Bridge=br5

[Files]
# Per-instance state dir on the host, mapped onto the instance-agnostic
# container path: the image (userfilters symlink), the live AdGuardHome.yaml
# and the s6 run script all keep referencing /data/adguard.
Bind=/data/adguard-bob:/data/adguard
