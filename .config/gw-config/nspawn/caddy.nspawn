[Exec]
Boot=on
# s6-overlay does not do a clean SIGTERM shutdown; without these, stop leaves
# stale s6-supervise procs that wedge the unit cgroup. Same combo as the
# adguard instances.
KillSignal=SIGKILL
Environment=S6_KILL_GRACETIME=0
# Network identity, read by the image's net-setup oneshot (with-contenv):
# static IPv4 + default route, and the SLAAC token set before host0 comes up
# so the v6 address is always <prefix>::a00:5b4. Static (not DHCP): this is
# the address the estate's DNS rewrites and port forwards send traffic to,
# and the UniFi controller cannot manage reservations for clients on the
# gateway's own bridge. The caddy service depends on the oneshot, so a
# missing value here keeps the proxy down rather than listening on a lease.
Environment=IPV4_CIDR=10.0.5.180/24
Environment=IPV4_GATEWAY=10.0.5.1
Environment=IPV6_TOKEN=::10.0.5.180
Capability=all
# The image bakes /etc/resolv.conf with public resolvers: the proxy stands in
# front of the AdGuard instances, so resolving through them would tie its
# startup and ACME DNS-01 renewals to what it fronts.
ResolvConf=off
Environment=XDG_CONFIG_HOME=/data/caddy/config
Environment=XDG_DATA_HOME=/data/caddy/data
Environment=HOME=/data/caddy
WorkingDirectory=/data/caddy

[Network]
Bridge=br5

[Files]
Bind=/data:/data
