# Vendored verbatim from unifi-utilities/unifi-common (udm-boot.service),
# pinned at upstream commit ae4984d04984e6a687c4696f17a13aa0672473cf (2026-04-02).
# Self-contained: the run-parts logic for /data/on_boot.d is inlined in
# ExecStart, so this single file in /etc/systemd/system is the whole hook.
[Unit]
Description=UniFi Common
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=bash -c 'mkdir -p /data/on_boot.d && find -L /data/on_boot.d -mindepth 1 -maxdepth 1 -type f -print0 | sort -z | xargs -0 -r -n 1 -- sh -c '\''if test -x "$0"; then echo "%n: running $0"; "$0"; else case "$0" in *.sh) echo "%n: sourcing $0"; . "$0";; *) echo "%n: ignoring $0";; esac; fi'\'
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
