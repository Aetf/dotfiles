# Homelab-only project pins (yadm hostname alternate: this file only
# materializes as conf.d/homelab.toml on Aetf-Arch-Homelab).
#
# Each of these repos is its own vfox tool plugin. Upgrade flow:
#   commit in the project repo -> push -> update the pin here (yadm commit,
#   so dotfiles history records what each host runs) -> `mise install`
#   (or just `yadm pull`; the post_pull hook runs mise).
# Scripts are reached through mise shims (~/.local/share/mise/shims/...),
# which is the stable path the systemd user units use.

[tools]
# On xps gmailctl comes from pacman; homelab has no root, so pin it here.
"ubi:mbrt/gmailctl" = "0.12.0"
"vfox:Aetf/homelab-ops" = "7a1996ddac030239a049882ca1bdf54ce7892cf5"
"vfox:Aetf/thread-dashboard" = "f10582602817406b3f5a40cda25bc04e3649a027"

[tasks."projects:sync"]
description = "Idempotent post-install sync: build container images from pinned sources, reload units"
run = """
#!/usr/bin/env bash
set -euo pipefail
# Images run on this host, so build them for this host's architecture —
# explicitly. The local store keeps one image per base tag (python:3.13-slim,
# alpine:3, ...), and a cross build (`--platform linux/arm64` for the gateway
# or the cloud pool) re-points that tag at the foreign variant; a build
# without --platform then silently reuses it and yields an image that only
# runs under qemu. With --platform, podman pulls the matching variant when
# the local one does not match. The arch check turns any regression into a
# failed sync instead of a slow emulated service.
# The raw blocks keep mise's Tera templating off podman's Go templates.
platform="linux/$(podman info --format '{% raw %}{{.Host.Arch}}{% endraw %}')"
build() {
    local tag=$1 ctx=$2 arch
    echo "building $tag for $platform from $ctx"
    podman build -q --platform "$platform" -t "$tag" "$ctx" >/dev/null
    arch=$(podman image inspect "localhost/$tag" --format '{% raw %}{{.Os}}/{{.Architecture}}{% endraw %}')
    if [[ $arch != "$platform" ]]; then
        echo "ERROR: localhost/$tag is $arch, expected $platform" >&2
        exit 1
    fi
}
build thread-dashboard "$(mise where vfox:Aetf/thread-dashboard)"
ho=$(mise where vfox:Aetf/homelab-ops)
build dmarc-check "$ho/dmarc-check"
build adguardhome-sync "$ho/adguardhome-sync"
build seedwatch "$ho/seedwatch"
systemctl --user daemon-reload
# Pick up a new image (or a unit change) if the service is supposed to run.
if systemctl --user is-enabled --quiet thread-dashboard.service 2>/dev/null; then
    systemctl --user restart thread-dashboard.service
fi
if systemctl --user is-active --quiet adguardhome-sync.service 2>/dev/null; then
    systemctl --user restart adguardhome-sync.service
fi
if systemctl --user is-active --quiet seedwatch.service 2>/dev/null; then
    systemctl --user restart seedwatch.service
fi
# dmarc-check is a timer-driven oneshot; nothing to restart — the next timer
# firing uses the freshly built image.
"""
