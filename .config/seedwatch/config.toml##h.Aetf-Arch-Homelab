# seedwatch policy (host config, mounted read-only into the container).
# Reference: ~/homelab-ops/seedwatch/src/seedwatch/config.py

[qbittorrent]
url = "http://127.0.0.1:9876"

[scan]
downloads = "/mnt/nas/Downloads"
# Only categories move.sh hardlinks into /mnt/nas/Media: the nlink
# criterion (and therefore auto-tagging) applies to nothing else.
managed_categories = ["动漫", "剧场版", "剧集", "电影"]
# Trust nlink==1 only this long after completion (move.sh race window).
grace_hours = 24
interval_minutes = 60

[reap]
# dry-run reports and audit-logs every intended action without mutating;
# vetted 2026-08-21 and switched live.
dry_run = false
default_ratio = 4.0

# Per-tracker overrides, matched by hostname suffix.
# or_seed_days would add a dead-tracker fallback (seeding N days also
# qualifies); deliberately unset for now.
[reap.trackers."m-team.cc"]
ratio = 4.0

[reap.trackers."byr.pt"]
ratio = 1.0
