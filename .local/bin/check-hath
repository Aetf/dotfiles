#!/usr/bin/env bash
# Periodic health check for the Hentai@Home client running in k8s (ns: hath).
# Driven by check-hath.timer (systemd user unit).
#
# Failure modes covered:
#   - pod missing or not Running/Ready        -> rollout restart
#   - client silent for hours (the H@H server probes the client regularly,
#     so a quiet log means the client lost its server connection)
#                                             -> rollout restart
#   - startup-notification loop (e.g. FAIL_INITIAL_SPEEDTEST)
#                                             -> alert only; a restart just
#                                                repeats the same failure
# Restarts and alerts are rate-limited via stamp files in $STATE_DIR.

set -euo pipefail

NS=hath
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/check-hath
SILENCE_LIMIT_MIN=180
COOLDOWN_MIN=360
MAILTO=pfyu817@gmail.com

mkdir -p "$STATE_DIR"

notify() {
    local subject=$1 body=$2
    echo "$subject"
    printf '%s\n' "$body" | mail -A Google -s "[check-hath] $subject" "$MAILTO" || true
}

# cooled_down NAME -> succeeds (and refreshes the stamp) at most once per
# COOLDOWN_MIN; fails while still in the window
cooled_down() {
    local stamp="$STATE_DIR/$1"
    if [[ -f $stamp ]] && (( $(date +%s) - $(stat -c %Y "$stamp") < COOLDOWN_MIN * 60 )); then
        return 1
    fi
    touch "$stamp"
}

restart_deploy() {
    local reason=$1
    if ! cooled_down last-restart; then
        echo "unhealthy ($reason) but still in restart cooldown"
        return
    fi
    kubectl -n "$NS" rollout restart "deploy/$DEPLOY"
    notify "restarted hath: $reason" "kubectl -n $NS rollout restart deploy/$DEPLOY"
}

DEPLOY=$(kubectl -n "$NS" get deploy -o jsonpath='{.items[0].metadata.name}')
POD=$(kubectl -n "$NS" get pods -l app=hath --no-headers -o custom-columns=:metadata.name | head -n1)

if [[ -z $POD ]]; then
    restart_deploy "no pod found"
    exit 0
fi

phase=$(kubectl -n "$NS" get pod "$POD" -o jsonpath='{.status.phase}')
ready=$(kubectl -n "$NS" get pod "$POD" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}')
if [[ $phase != Running || $ready != True ]]; then
    restart_deploy "pod $POD phase=$phase ready=$ready"
    exit 0
fi

recent=$(kubectl -n "$NS" logs "$POD" --tail=30 2>/dev/null || true)
if grep -q 'Startup Failure' <<<"$recent"; then
    if cooled_down last-startup-failure-alert; then
        notify "startup failure loop, restart will not help" \
            "$(grep 'Startup Failure' <<<"$recent" | tail -3)"
    else
        echo "startup failure loop (already alerted)"
    fi
    exit 0
fi

last_ts=$(kubectl -n "$NS" logs "$POD" --tail=1 --timestamps 2>/dev/null | cut -d' ' -f1)
age_min=
if [[ -n $last_ts ]]; then
    age_min=$(( ($(date +%s) - $(date -d "$last_ts" +%s)) / 60 ))
    if (( age_min > SILENCE_LIMIT_MIN )); then
        restart_deploy "no log activity for ${age_min}min"
        exit 0
    fi
fi

echo "healthy: pod=$POD last_log_age=${age_min:-?}min"
