#!/usr/bin/env bash
# cq — headless Claude Code on the Max plan's monthly API credit, for when the
# subscription's usage limits are exhausted.
#
# Interactive sessions (terminal, Remote Control, the Claude app) always draw on
# the subscription. `claude -p` run with an API key from the Console organization
# linked to the plan is billed as Agent SDK usage and draws on the monthly API
# credit instead (support.claude.com/en/articles/17154008). cq runs `claude -p`
# that way against the normal config dir, so CLAUDE.md, the vault memory and the
# skills load exactly as in any session.
#
# Usage:
#   cq [-k KEYS] [-m MODEL] [PROMPT...]  new session
#   cq -c [-m MODEL] [PROMPT...]         continue the last cq session
#   cq -r SESSION_ID [-m MODEL] [PROMPT...]
#                                        fork any session (e.g. a stalled RC session)
#                                        and continue the fork
# With a PROMPT, run that one turn and exit; without one, read turns from a
# prompt line by line (Ctrl-D quits). Every turn continues the same session.
#
# Credentials come from ~/.config/claude-code-keys/KEYS.env (yadm, git-crypt;
# default KEYS=claude-api): every KEY=VALUE line there is passed to claude, so
# a file can also point it at another endpoint (e.g. -k deepseek). A file that
# sets neither ANTHROPIC_API_KEY nor ANTHROPIC_AUTH_TOKEN is refused, so cq
# never falls back to the subscription login.
#
# `-r` always forks: the original transcript may belong to a live process, and
# two processes appending to one session corrupt it. `--continue` is never used:
# all directories share one project here, so "the most recent session" would be
# whatever RC session ran last.

set -euo pipefail

KEYS_DIR=${CQ_KEYS_DIR:-$HOME/.config/claude-code-keys}
keys=claude-api
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/cq
LAST=$STATE_DIR/last-session
PERMISSION_MODE=${CQ_PERMISSION_MODE:-auto}

die() { printf 'cq: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '/^# Usage:/,/^# With a PROMPT/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

session="" fork=0 model=()
while getopts ':ck:r:m:h' opt; do
    case $opt in
        c) [[ -r $LAST ]] || die "no previous cq session ($LAST)"
           session=$(<"$LAST") ;;
        k) keys=$OPTARG ;;
        r) session=$OPTARG fork=1 ;;
        m) model=(--model "$OPTARG") ;;
        h) usage ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

KEY_FILE=$KEYS_DIR/$keys.env
[[ -r $KEY_FILE ]] || die "no credentials file $KEY_FILE"
command -v claude >/dev/null || die "claude not on PATH"
command -v jq >/dev/null || die "jq not on PATH"
mkdir -p "$STATE_DIR"

# A claude started inside a Claude Code session inherits its messaging socket and
# session variables and attaches to the parent session. Start from an empty
# environment and pass through only what the CLI needs.
passthrough=(HOME USER LOGNAME SHELL PATH LANG LC_ALL TERM XDG_RUNTIME_DIR
             CLAUDE_CONFIG_DIR CLAUDE_CODE_PROJECT_DIR_NAME TMUX_TMPDIR)
envv=()
for v in "${passthrough[@]}"; do
    [[ -n ${!v:-} ]] && envv+=("$v=${!v}")
done
auth=0
while IFS= read -r line || [[ -n $line ]]; do
    line=${line#export }
    [[ $line =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    name=${BASH_REMATCH[1]} value=${BASH_REMATCH[2]}
    [[ $value =~ ^\"(.*)\"$ || $value =~ ^\'(.*)\'$ ]] && value=${BASH_REMATCH[1]}
    envv+=("$name=$value")
    [[ $name == ANTHROPIC_API_KEY || $name == ANTHROPIC_AUTH_TOKEN ]] && [[ -n $value ]] && auth=1
done <"$KEY_FILE"
(( auth )) || die "$KEY_FILE sets neither ANTHROPIC_API_KEY nor ANTHROPIC_AUTH_TOKEN"

# stream-json events -> readable text. Lines starting with \x1e carry the
# session id back to the shell instead of being printed.
render='
def dim: "\u001b[2m" + . + "\u001b[0m";
if .type == "system" and .subtype == "init" then
  "\u001eSID " + .session_id, ("session " + .session_id + " · " + .model + " · " + .permissionMode | dim)
elif .type == "assistant" then
  .message.content[]? |
  if .type == "text" then .text
  elif .type == "tool_use" then ("▸ " + .name + " " + (.input | tostring | .[0:160])) | dim
  else empty end
elif .type == "result" then
  "\u001eSID " + .session_id,
  (if .is_error then ("error: " + (.result // .subtype)) else empty end),
  ("· " + .subtype + " · $" + ((.total_cost_usd // 0) * 1000 | round / 1000 | tostring)
     + " · " + (.num_turns | tostring) + " turns" | dim)
else empty end'

turn() { # $1 = prompt
    local args=(-p "$1" --output-format stream-json --verbose
                --permission-mode "$PERMISSION_MODE" "${model[@]}")
    if [[ -n $session ]]; then
        args+=(--resume "$session")
        (( fork )) && args+=(--fork-session)
    fi
    local line rc
    while IFS= read -r line; do
        if [[ $line == $'\x1e'SID\ * ]]; then
            session=${line#$'\x1e'SID }
        else
            printf '%s\n' "$line"
        fi
    done < <(env -i "${envv[@]}" claude "${args[@]}" | jq -r --unbuffered "$render")
    wait $! && rc=0 || rc=$?
    if [[ -n $session ]]; then
        printf '%s\n' "$session" >"$LAST"
        fork=0   # later turns continue the fork itself
    fi
    return "$rc"
}

if (( $# )); then
    turn "$*"
    exit
fi

while IFS= read -r -e -p 'cq> ' prompt; do
    [[ -n ${prompt//[[:space:]]/} ]] || continue
    history -s -- "$prompt"
    turn "$prompt" || printf 'cq: turn failed (exit %s)\n' "$?" >&2
done
echo
