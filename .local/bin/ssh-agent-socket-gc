#!/usr/bin/env bash
# Sweep orphaned SSH agent sockets, and keep ~/.ssh/ssh_auth_sock on a live one.
#
# OpenSSH 10 moved agent sockets out of /tmp and into ~/.ssh/agent, so that a
# process confined to /tmp cannot ambiently reach the agent. The cost, called
# out in the 10.1 release notes, is that the OS no longer sweeps stale sockets,
# and ~/.ssh survives reboots, so they accumulate forever.
#
# `ssh-agent -u` is upstream's answer: it deletes sockets under ~/.ssh/agent
# that are older than an hour and refuse a non-blocking connect, restricted to
# ones whose embedded hostname hash matches this host. sshd's forwarded sockets
# are tagged "sshd" rather than created by ssh-agent, but they are not
# special-cased, so they are swept too. Not -uu: that ignores the hostname hash,
# which only matters for a shared $HOME and would reach another host's live
# sockets.
#
# The age guard is what makes this safe rather than the staleness test - a
# socket's mtime never advances after bind, so a month-old live session looks
# exactly as old as a corpse, and only the connect attempt tells them apart.
#
# ssh-agent resolves the directory from the passwd entry, not $HOME, so this
# cannot be redirected at a scratch directory to test it.
#
# Only useful where sshd actually uses ~/.ssh/agent, i.e. OpenSSH >= 10. macOS
# ships 9.x and keeps forwarded sockets in /tmp, which the OS sweeps on its own,
# so there is nothing to do there - and neither ssh-agent -u nor ss exists.
set -euo pipefail

if ! ssh-agent -u; then
    echo "ssh-agent has no -u (needs OpenSSH >= 10); nothing swept" >&2
    exit 0
fi

# ~/.ssh/ssh_auth_sock is the fixed path every shell exports (see
# zsh/env.d/10-ssh-agent.zsh); each login repoints it. It dangles once the
# session that last claimed it ends. Shells cope with that on their own, this
# just hands it to another live agent if one is around.
stable=$HOME/.ssh/ssh_auth_sock
dir=$HOME/.ssh/agent

# A socket is "usable" iff a bounded ssh-add -l neither refuses (orphan file,
# exit >=2 or ENOENT) nor hangs (a session whose client vanished stays LISTEN
# and never answers - the timeout is what tells that apart from a live agent,
# which ss -xl cannot). rc 0 (keys) and 1 (no keys) both mean the agent spoke.
usable() {
    local rc
    SSH_AUTH_SOCK=$1 timeout 5 ssh-add -l >/dev/null 2>&1
    rc=$?
    [[ $rc -eq 0 || $rc -eq 1 ]]
}

# Repoint the fixed symlink whenever it does not currently resolve to a usable
# agent - dangling, or pointing at a stale/hung socket (today's failure mode).
if [[ -L $stable ]] && ! usable "$stable" && [[ -d $dir ]]; then
    shopt -s nullglob
    newest=""
    for sock in "$dir"/s.*; do
        [[ -S $sock ]] && usable "$sock" || continue
        [[ -z $newest || $sock -nt $newest ]] && newest=$sock
    done

    if [[ -n $newest ]]; then
        echo "repointing $stable at $newest"
        ln -sfn -- "$newest" "$stable"
    elif [[ ! -S $stable ]]; then
        echo "no live agent left, removing dangling $stable"
        rm -f -- "$stable"
    fi
fi
