# ControlPersist is 10m rather than yes throughout: "yes" keeps a master alive
# forever, so ~/.ssh/masters accumulated sockets months old, and each master
# holding an SSH_AUTH_SOCK forwarded from a client that had long since gone away
# left a half-dead agent socket behind in ~/.ssh/agent that hangs ssh-add.

# Never forward the agent into this very machine. The forwarded socket would
# chain back to the agent it came from, and once a login shell points
# ~/.ssh/ssh_auth_sock at it every agent request loops sshd <-> ssh forever.
# First value wins in ssh_config, so this sits above every Include.
{% if yadm.hostname == "Aetf-Arch-Homelab" %}
Host homelab homelabzt
    ForwardAgent no
{% endif %}
{% if yadm.hostname == "Aetf-Arch-XPS" %}
Host xps
    ForwardAgent no
{% endif %}

# The block above opens a Host scope; `Match all` closes it so the includes
# below stay top-level. Without this the includes nest inside the last Host
# block and every host declared in them silently stops matching.
Match all

# include all entries in ~/.ssh/config.d
Include config.d/*
# include all configs for work
Include ~/.config/work/ssh/config.d/*

Host github
    User git
    HostName github.com

Host archvps
    User aetf
    HostName archvps.hosts.unlimited-code.works
    Port 59901
    ForwardAgent yes

# Defaults shared by every host, and last on purpose: ssh keeps the first value
# it obtains for a keyword, so everything above — including every Include — wins
# over this block. Agent forwarding is not here; it is granted per host.
Host *
    ForwardX11 no
    # Notice a vanished peer within ~90s instead of holding the session (and
    # any agent socket forwarded through it) open until TCP gives up.
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.ssh/masters/%n:%r@%h:%p
    ControlPersist 10m
