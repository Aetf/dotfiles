# Same machine, two routes: the LAN name and the ZeroTier name. Each address
# block carries only what differs; the shared settings live in the merged block
# below it, because ssh keeps the *first* value it obtains for a keyword — a
# more specific block must come before the general one.

Host homelab
    HostName Aetf-Arch-Homelab.home.arpa

Host homelabzt
    HostName Aetf-Arch-Homelab.zt.unlimited-code.works

Host homelab homelabzt
    User aetf
    Port 59901
    ForwardAgent yes
    RemoteForward ${XDG_RUNTIME_DIR}/gnupg/d.gw4c7sokt7xg5tw4jxtiegyr/S.gpg-agent ${XDG_RUNTIME_DIR}/gnupg/d.gw4c7sokt7xg5tw4jxtiegyr/S.gpg-agent.extra
    StreamLocalBindUnlink yes

Host xps
    User aetf
    HostName aetf-arch-xps.zt.unlimited-code.works
    Port 59901
    ForwardX11 yes
    ForwardX11Trusted yes
    ForwardAgent yes

Host haos
    User root
    HostName homeassistant.local
    ForwardAgent yes

Host gw
    User root
    HostName dmse.home.arpa
    ForwardAgent yes

Host rpi
    User root
    HostName rpi.iot.home.arpa
    ForwardAgent yes

Host 3dp
    User mks
    HostName qidi-plus4.iot.home.arpa
    ForwardAgent yes
